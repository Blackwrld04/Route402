# Route402 Environment Configuration
# Copy to .env for live testnet / 1Click / NEAR AI Cloud execution.
# Leave unset for zero-key `npm run demo` mode.

# Execution mode: demo | dry | live
ROUTE402_MODE=demo

# NEAR Network Configuration
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
ROUTE402_REGISTRY_ID=v1.route402.testnet
ROUTE402_USDC_ID=usdc.route402.testnet

# Optional Signer for Facilitator / Automated Demo Scripts (never commit real keys!)
NEAR_SIGNER_ID=
NEAR_PRIVATE_KEY=

# Optional NEAR Intents 1Click Partner JWT (https://partners.near-intents.org)
# Without JWT, dry: true quotes still work against https://1click.chaindefuser.com/v0/quote
ONE_CLICK_API_URL=https://1click.chaindefuser.com
ONE_CLICK_JWT=

# Optional NEAR AI Cloud API Key for TEE-attested upstream inference (https://cloud.near.ai)
NEAR_AI_API_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=

# Gateway & Web Ports
GATEWAY_PORT=4020
WEB_PORT=4021
