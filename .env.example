# Route402 environment variables
#
# Scripts do NOT auto-load this file. Copy it to `.env` for reference, then
# export the values into your shell before running, for example:
#   set -a; source .env; set +a
# Leave everything unset for the zero-key `npm run demo` sandbox.

# Runtime mode: demo | dry | live
# Read by `scripts/demo.ts` and the standalone gateway CLI.
ROUTE402_MODE=demo

# NEAR Testnet RPC used by `start:dry`, `start:live`, `verify:testnet`, and the
# gateway's onchain receipt checks.
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Registry and test-USDC contracts used by `scripts/demo.ts` in dry/live mode
# and by the MCP server as the pinned collection.
NEAR_REGISTRY_ID=r402-reg-v1.testnet
NEAR_USDC_CONTRACT_ID=r402-usdc-v1.testnet

# The standalone gateway CLI (`npm run gateway`) uses these names instead.
# It defaults to the sandbox IDs below; set them to the Testnet IDs above for
# real RPC reads.
ROUTE402_REGISTRY_ID=v1.route402.testnet
ROUTE402_USDC_ID=usdc.route402.testnet

# Ports:
# - `npm run demo` unified server: gateway PORT=4402, web WEB_PORT=4173
# - standalone gateway CLI: GATEWAY_PORT=4020
PORT=4402
WEB_PORT=4173
GATEWAY_PORT=4020

# Optional NEAR Intents 1Click partner JWT.
# Without a JWT, `dry: true` quotes still work against the public quote API.
ONE_CLICK_API_URL=https://1click.chaindefuser.com
ONE_CLICK_JWT=

# Optional NEAR AI Cloud credentials for the tee-auditor upstream.
# A response digest is recorded, but TEE attestation is NOT independently
# verified by this repo.
NEAR_AI_API_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=

# Agent MCP server (`npm run mcp`).
ROUTE402_GATEWAY_URL=http://127.0.0.1:4402
ROUTE402_AGENT_ID=buyer-agent.route402.testnet

# Vite dev-server proxy target for `npm run web:dev` (production build is
# served by the unified demo server instead).
VITE_GATEWAY_URL=http://127.0.0.1:4402
